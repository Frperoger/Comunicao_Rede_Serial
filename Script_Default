# ================= LOG =================
def log(msg, maquina="GERAL"):
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    caminho = os.path.join(PASTA_LOG, f"{maquina}.log")
    with open(caminho, "a", encoding="utf-8") as f:
        f.write(f"[{ts}] {msg}\n")
    print(f"[{maquina}] {msg}")
    
def log_geral_evento(maquina, ip, evento):
    log(f"[{maquina} | {ip}]{evento}","GERAL")

#Selecionador do 1º arquivo
def pegar_arquivo(pasta):
    arquivos = [f for f in os.listdir(pasta)
                if os.path.isfile(os.path.join(pasta, f))]
    if not arquivos:
        return None
    return os.path.join(pasta, arquivos[0])

def enviar_auto(conn, caminho, maquina):
    log("Envio iniciado", maquina)
    with open(caminho, "rb") as f:
        linhas = list(f)
    if not linhas:
        return "NORMAL"
    try:
        conn.sendall(linhas[0])
        time.sleep(0.01)
    except (ConnectionResetError, BrokenPipeError, OSError):
        log("Conexão perdida durante envio", maquina)
        return
    # DETECTA INICIAL DE DNC
    modo_dnc = False
    pausado = False
    # DETECTA RESET
    bytes_enviados = 0
    ultimo_xoff = time.time()
    esperando_consumo = False 
    reset_count = 0
    max_reset = 3
    try:
        pronto, _, _ = select.select([conn], [], [], 0.5)
        if pronto:
            dados = conn.recv(64)
            for ctrl in dados:
                if ctrl == 0x13:  # XOFF
                    modo_dnc = True
                    pausado = True
                    maquina_atividade(maquina, "Usinando")
                elif ctrl == 0x11:  # XON
                    pausado = False
    except:
        pass
    # MODO NORMAL 
    if not modo_dnc:
        try:
            dados = b"".join(linhas[1:])
            tamanho_bloco = 10
            indice = 0
            total = len(dados)
            while indice < total:

                try:
                    while True:
                        pronto, _, _ = select.select([conn], [], [], 0.01)
                        if not pronto:
                            break
                        ctrl_bytes = conn.recv(10)
                        if not ctrl_bytes:
                            log("Conexão perdida durante envio", maquina)
                            return "NORMAL"
                        for ctrl in ctrl_bytes:
                            if ctrl == 0x13:  # XOFF
                                ultimo_xoff = time.time()
                                esperando_consumo = True
                                pausado = True
                                modo_dnc = True
                                maquina_atividade(maquina, "Usinando")
                            elif ctrl == 0x11: #XON
                                pausa = time.time() - ultimo_xoff
                                restante = len(dados) - indice
                                if esperando_consumo and pausa > 0.5 and bytes_enviados > 20:
                                    log("Reset Detectado - reiniciando envio", maquina)
                                    reset_count += 1
                                    if reset_count >= max_reset:
                                        log("Muitos Resets - Reiniciando conexão",maquina)
                                        return "ABORTAR"
                                    return "RESET"  
                                pausado = False
                                esperando_consumo = False
                        if modo_dnc:
                            break
                    if modo_dnc:
                        break
                except:
                    pass
                # ENVIO RÁPIDO
                bloco = dados[indice:indice + tamanho_bloco]
                conn.sendall(bloco)
                bytes_enviados += len(bloco)
                indice += len(bloco)
            # TROCOU PARA DNC
            if modo_dnc:
                restante = dados[indice:]
                linhas_restantes = restante.splitlines(keepends=True)
                linhas = [b""] + linhas_restantes
                indice = 1
                bytes_enviados = 0
            else:
                log("Transferência finalizada", maquina)
                log_geral_evento(maquina, conn.getpeername()[0], "Programa enviado com sucesso")
                return "NORMAL"
        except (ConnectionResetError, BrokenPipeError, OSError):
            log("Conexão perdida durante envio", maquina)
            return "NORMAL"
    # MODO DNC COM XON/XOFF
    ultimo_xoff = time.time()
    ultimo_xoff_dnc = time.time()
    esperando_consumo_dnc= False
    indice = 1
    ultimo_fluxo = time.time()
    while indice < len(linhas):
        dados = b""
        try:
            while True:
                pronto, _, _ = select.select([conn], [], [], 0.2)
                if not pronto:
                    break
                parte = conn.recv(64)
                if not parte:
                    log("Conexão perdida durante envio", maquina)
                    return "DNC"
                dados += parte
                if len(parte) < 64:
                    break
        except:
            pass
        for ctrl in dados:
            ultimo_fluxo = time.time()
            if ctrl == 0x13:  # XOFF
                pausado = True
                esperando_consumo_dnc = True
                ultimo_xoff_dnc = time.time()
                maquina_atividade(maquina, "Usinando")
            elif ctrl == 0x11:  # XON
                pausa = time.time() - ultimo_xoff_dnc
                if esperando_consumo_dnc and pausa > 0.5:
                    log ("Reset detectado durante DNC",maquina)
                    reset_count += 1
                    if reset_count >= max_reset:
                        log ("Muitos resets - Reiniciando conexão",maquina)
                        return "ABORTAR"
                    return "RESET"
                pausado = False
                esperando_consumo_dnc = False
        if time.time() - ultimo_fluxo > 1.5:
            pausado = True
        if pausado:
            continue
        try:
            conn.sendall(linhas[indice])
        except (ConnectionResetError, BrokenPipeError, OSError):
            log("Conexão perdida durante envio", maquina)
            return "DNC"
        indice += 1
    log("Programa finalizado", maquina)
    log_geral_evento(maquina, conn.getpeername()[0], "Usinagem finalizada")
    return "DNC"

def atender_conexao(conn, addr):
    conn.settimeout(0.5)
    ip = addr[0]
    log(f"Conectado: {addr}")
    maquina = MAQUINA_POR_IP.get(ip, "DESCONHECIDA")
    estado = "IDLE"
    buffer = b""
    Recebendo = False
    ultimo_ping = time.time()
    if maquina in maquinas:
        maquina_Online(maquina,ip)
    log_geral_evento(maquina, ip, "CONEXÃO ESTABELECIDA")
    try:
        while True:
            Recebendo = False
            if time.time() - ultimo_ping > 8:
                try:
                    conn.send(b'\x00')
                except:
                    log("Conexão perdida - aguardando reconexão",maquina)
                    break
                ultimo_ping = time.time()
            try:
                data = conn.recv(4096)
                if not data:
                    time.sleep(0.1)
                    continue
            except socket.timeout:
                maquina_Online(maquina)
                continue
            except ConnectionResetError:
                log("Reconectando após desconexão",maquina)
                break

            for byte in data:
                b = bytes([byte])
#=================================================== IDLE ===========================================
                if estado == "IDLE":
                    if maquina == "DESCONHECIDA":
                        log(f"IP não mapeado: {ip}", "GERAL")
                        continue
                    if b in HANDSHAKE:
                        maquina_conectada(maquina, ip)
                        pasta = os.path.join(PASTA_ENVIAR, maquina)
                        log("Preparando envio", maquina)
                        caminho = pegar_arquivo(pasta)
                        if caminho:
                            estado = "ENVIANDO"
                            maquina_atividade(maquina, "Enviando")
                            modo = enviar_auto(conn, caminho, maquina)
                            if modo == "RESET":
                                log ("Reiniciando programa após RESET",maquina)
                                modo = enviar_auto(conn,caminho,maquina)
                            elif modo == "ABORTAR":
                                log("Sessão abortada por excesso de RESET",maquina)
                                break   
                            if modo =="NORMAL":
                                os.remove(caminho)
                                log("Arquivo removido após envio", maquina)
                            maquina_atividade(maquina, "Repouso")
                            maquina_Online(maquina,ip)
                        estado = "IDLE"
                        continue
                    if b == b"%":
                        buffer = b"%"
                        estado = "RECEBENDO"
                        continue
                elif estado == "RECEBENDO":
                    maquina_Online(maquina)
                    if not Recebendo:
                        maquina_atividade(maquina, "Recebendo")
                        Recebendo = True
                    buffer += b
                    if b == b"%":
                        texto = buffer.decode("latin-1", errors="ignore")
                        linhas = texto.splitlines()
                        primeira_linha = "PROGRAMA"
                        for l in linhas:
                            l = l.strip()
                            if l and l != "%":
                                primeira_linha = l
                                break
                        invalidos = r'<>:"/\\|?*;'
                        for c in invalidos:
                            primeira_linha = primeira_linha.replace(c, "")
                        timestamp = datetime.now().strftime("d%d-%Hh-%Mm-%Ss")
                        nome = f"{maquina}_{primeira_linha}_{timestamp}.nc" #nome do arquivo recebido
                        caminho = os.path.join(PASTA_RECEBER, nome)
                        with open(caminho, "wb") as f:
                            f.write(buffer)
                        log(f"Arquivo recebido: {nome}", maquina)
                        log_geral_evento(maquina, ip, f"RECEBIDO ({nome})")
                        buffer = b""
                        estado = "IDLE"
                        maquina_atividade(maquina, "Repouso")
                        continue
                elif estado in ("ENVIANDO", "DNC"):
                    continue

    except ConnectionResetError:
        log("Conexão encerrada pela máquina (10054)", maquina)

    except OSError as e:
        if hasattr(e, "winerror") and e.winerror == 10054:
            log("Conexão cancelada pelo host remoto (10054)", maquina)
        else:
            log(f"Erro socket: {e}", maquina)

    except Exception as e:
        log(f"Erro inesperado: {e}", maquina)
    finally:
        if maquina in maquinas:
            maquina_Offline(maquina)
        conn.close()
        log("Conexão encerrada", maquina)
        log_geral_evento(maquina, ip, "CONEXÃO ENCERRADA")

def dnc_loop():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF,65536)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF,65536)    
    sock.bind((HOST, PORT))
    sock.listen(50)#quantidade de portas serem ouvidas
    log("Servidor DNC iniciado")
    while True:
        conn, addr = sock.accept()
        conn.setsockopt(socket.IPPROTO_TCP,socket.TCP_NODELAY,1)
        conn.setsockopt(socket.SOL_SOCKET,socket.SO_KEEPALIVE,1)
        try:
            conn.ioctl(socket.SIO_KEEPALIVE_VALS,(1,10000,3000))
        except:
            pass
        threading.Thread(target=atender_conexao, args=(conn, addr), daemon=True).start()

