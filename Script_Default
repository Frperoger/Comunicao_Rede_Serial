# máquinas fixas
NOMES_MAQUINAS = [
    "CNC01",
    "CNC02",
    "Galaxy20",
    "G240",
    "Galaxy50",
    "Multiplic35D",
]

maquinas = {}
lock = Lock()
monitor_clientes = []
monitor_lock = Lock()
monitor_last_seen ={}

for nome in NOMES_MAQUINAS:
    maquinas[nome] = {
        "status": "Offline",
        "atividade":"Repouso",
        "ip":"-",
        "last_seen": time.time()
    }

TIMEOUT = 20 

def maquina_conectada(nome, ip):
    with lock:
        maquinas[nome]["status"] = "Online"
        maquinas[nome]["atividade"] = "Disponivel"
        maquinas[nome]["ip"] = ip
        maquinas[nome]["last_seen"] = time.time()
    estado_evento.set()

def maquina_Online(nome,ip=None):
    with lock:
        maquinas[nome]["status"] = "Online"
        if maquinas[nome]["atividade"] == "Repouso":
            maquinas[nome]["atividade"] = "Disponivel"
        if ip:
            maquinas[nome]["ip"] = ip
        maquinas[nome]["last_seen"] = time.time()
    estado_evento.set()

estado_evento = threading.Event()
def maquina_status(maquina,status):
    with lock:
        maquinas[maquina]["status"] = status
    estado_evento.set()        

def maquina_atividade(nome, atividade):
    with lock:
        maquinas[nome]["atividade"] = atividade
        maquinas[nome]["last_seen"] = time.time()
    estado_evento.set()

def maquina_Offline(nome):
    with lock:
        maquinas[nome]["status"] = "Offline"
        maquinas[nome]["atividade"] = "Repouso"
        maquinas[nome]["ip"] = "-"
    estado_evento.set()

def servidor_estado():
    while True:
        estado_evento.wait()
        with lock:
            dados = json.dumps(maquinas)
        with monitor_lock:
            clientes = monitor_clientes.copy()
        for conn in clientes:
            try:
                conn.sendall((dados+"\n").encode())
                monitor_last_seen[conn] = time.time()
            except:
                with monitor_lock:
                    if conn in monitor_clientes:
                        monitor_clientes.remove(conn)
                    if conn in monitor_last_seen:
                        del monitor_last_seen[conn]
        estado_evento.clear()
        
def limpar_clientes_mortos():
    while True:
        time.sleep(30)
        agora = time.time()
        with monitor_lock:
            for conn in monitor_clientes[:]:
                if agora - monitor_last_seen.get(conn,0) > 120:
                    try:
                        conn.close()
                    except:
                        pass
                    monitor_clientes.remove(conn)
                    if conn in monitor_last_seen:
                        del monitor_last_seen[conn]

def monitor_timeout():
    while True:
        time.sleep(1)
        agora = time.time()
        with lock:
            for nome, m in maquinas.items():
                if agora - m ["last_seen"] <TIMEOUT:
                    continue
                if m["atividade"] in ("Usinando","Enviando","Recebendo"):
                    continue
                maquinas[nome]["status"] = "Offline"
                maquinas[nome]["atividade"] = "Repouso"
                maquinas[nome]["ip"] = "-"
